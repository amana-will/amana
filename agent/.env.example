# Copy this file to .env and fill in what you need. Everything is optional for the local demo.

# BNB Chain RPC. Testnet default: https://bsc-testnet-rpc.publicnode.com
RPC_URL=

# A wallet that ONLY pays gas (a little BNB) so the agent can finalize releases and pay heirs.
# Never put real savings in it. Without it, the agent still alerts people and anyone can press the buttons.
KEEPER_PRIVATE_KEY=

# Public address of this app, used in links the agent sends (e.g. https://amana.example.com)
APP_URL=http://localhost:3000
PORT=3000
POLL_SECONDS=15

# Claude reads people's wishes. Without a key, Amana's simpler built-in reader is used.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Telegram alerts: create a bot with @BotFather and paste its token.
TELEGRAM_BOT_TOKEN=


# The agent's sealing key (guardians send it their key pieces after a release). Generated automatically into
# agent/data/agent-key.json on first run. Back that file up: without it, pieces already sent can't be read.
AGENT_SEAL_KEY=
